%% macrostyle.sty --- house style for the Macroeconomic Theory I class notes
%% ---------------------------------------------------------------------------
%% FIXED FORMAT.  Every lesson file starts with
%%     \documentclass[11pt]{article}
%%     \usepackage{macrostyle}
%%     \lessonheader{<number>}{<subtitle>}{<date or empty>}
%% and nothing else in the preamble.  Do not change this file per lesson:
%% change it once, and every lesson recompiles with the new look.
%% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{macrostyle}[2026/09/15 v1.0 House style for macro class notes]

\RequirePackage[T1]{fontenc}
\RequirePackage[margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{enumitem}
\RequirePackage{parskip}
\RequirePackage{needspace}
\RequirePackage{booktabs}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta}

% ------------------------------------------------------------------ look ----
\linespread{1.06}
\setlength{\parindent}{0pt}
\setcounter{secnumdepth}{2}

% -------------------------------------------------------------- notation ----
\newcommand{\R}{\mathbb{R}}                              % real numbers
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}     % partial derivative
\newcommand{\kh}{\hat{k}}                                % capital per effective worker
\newcommand{\yh}{\hat{y}}                                % output per effective worker
\newcommand{\ch}{\hat{c}}                                % consumption per effective worker
\newcommand{\ih}{\hat{\imath}}                           % investment per effective worker
\newcommand{\dk}{\dot{\hat{k}}}                          % time derivative of k-hat
\newcommand{\gr}[1]{\frac{\dot{#1}}{#1}}                 % growth rate  \dot X / X
\newcommand{\gam}{(\delta+n+x)}                          % effective depreciation rate

% --------------------------------------------------------- title block ------
% \lessonheader{<title>}{<subtitle>}{<date --- may be empty>}
\newcommand{\lessonheader}[3]{%
  \begin{center}
    {\large\scshape Macroeconomic Theory I --- Class Notes}\\[3pt]
    {\LARGE\bfseries #1}\\[4pt]
    {\itshape #2}%
    \ifx\relax#3\relax\else\\[3pt]{\small #3}\fi
  \end{center}
  \vspace{0.4em}\hrule\vspace{0.9em}%
}

% ------------------------------------------------------------- headings -----
% A bold heading on its own line (used instead of a numbered subsection).
\newcommand{\topic}[1]{\par\Needspace{4\baselineskip}\medskip\noindent\textbf{#1}\par\nobreak\smallskip}
% A bold run-in heading: \runin{Walras' law.} then the text continues.
\newcommand{\runin}[1]{\par\medskip\noindent\textbf{#1}\quad\ignorespaces}

% --------------------------------------------------------------- lists ------
\newenvironment{flatlist}%
  {\begin{itemize}[leftmargin=1.3em,itemsep=2pt,topsep=3pt,parsep=0pt]}%
  {\end{itemize}}
\newenvironment{flatnum}%
  {\begin{enumerate}[leftmargin=1.5em,itemsep=2pt,topsep=3pt,parsep=0pt]}%
  {\end{enumerate}}

% -------------------------------------------------- transcription notes -----
% Small-print list at the end of a lesson: what was fixed, what is uncertain.
\newenvironment{transcriptnotes}%
  {\par\vspace{1.4em}\Needspace{6\baselineskip}\hrule\vspace{0.5em}\small
   \noindent\textbf{Source notes}\par\vspace{0.2em}%
   \begin{itemize}[leftmargin=1.2em,itemsep=1.5pt,topsep=2pt,parsep=0pt]}%
  {\end{itemize}}

% ------------------------------------------------------------- diagrams -----
\tikzset{
  ecaxis/.style = {-{Stealth[length=4pt,width=3pt]},line width=0.5pt},
  budget/.style = {line width=0.9pt},
  adm/.style    = {line width=2.4pt},
  bundle/.style = {circle,fill=black,inner sep=1.4pt},
  ecnode/.style = {font=\small,inner sep=1.8pt}
}
% \ecaxes{<x-max>}{<y-max>}  --- two plain axes, origin bottom-left
\newcommand{\ecaxes}[2]{%
  \draw[ecaxis] (0,0) -- (#1,0);%
  \draw[ecaxis] (0,0) -- (0,#2);}

\endinput
