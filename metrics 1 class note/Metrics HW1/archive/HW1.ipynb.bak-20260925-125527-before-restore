   "source": [
    "df['dr'] = df['r'].diff()       # Δr_t\n",
    "df['dy'] = df['y'].diff()       # Δy_t\n",
    "df['pi_1'] = df['pi'].shift(1)  # π_{t-1}\n",
    "df['dy_1'] = df['dy'].shift(1)  # Δy_{t-1}\n",
    "df['dr_1'] = df['dr'].shift(1)  # Δr_{t-1}\n",
    "df['dr_2'] = df['dr'].shift(2)  # Δr_{t-2}\n",
    "df[['r', 'dr', 'pi_1', 'dy_1', 'dr_1', 'dr_2']].head()\n",
    "\n",
    "def ols(x,y):\n",
    "    b= np.linalg.inv(x.T@x) @ x.T @ y\n",
    "    \n",
    "    y_hat = x @ b\n",
    "    \n",
    "    e= y-y_hat\n",
    "\n",
    "    n,k= x.shape\n",
    "    \n",
    "    v = (e@e/(n-k))@np.linalg.inv(x.T@x)  \n",
    "\n",
    "    s_e= np.sqrt(np.diag(var_co_m))\n",
    "\n",
    "\n",
    "    return b, y_hat,e, var_co_m, s_e\n",
    "\n",
