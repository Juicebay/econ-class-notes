    "def ols(x, y):\n",
    "    b = np.linalg.inv(x.T @ x) @ x.T @ y     # b = (X'X)^-1 X'y\n",
    "    y_hat = x @ b                            # fitted values\n",
    "    e = y - y_hat                            # residuals\n",
    "\n",
    "    n, k = x.shape                           # n observations, k parameters\n",
    "    var_co_m = (e @ e / (n - k)) * np.linalg.inv(x.T @ x)   # sigma^2 * (X'X)^-1\n",
    "\n",
    "    s_e = np.sqrt(np.diag(var_co_m))         # standard errors\n",
    "\n",
    "    return b, y_hat, e, var_co_m, s_e"
   ]
