%% metricsstyle.sty --- house style for the Econometrics I class notes
%% ---------------------------------------------------------------------------
%% FIXED FORMAT.  Every lesson file starts with
%%     \documentclass[11pt]{article}
%%     \usepackage{metricsstyle}
%%     \begin{document}
%%     \lessonheader{<number>}{<subtitle>}{<date or empty>}
%% and nothing else in the preamble.  Do not change this file per lesson:
%% change it once and every lesson recompiles with the new look.
%% (Sibling of microstyle.sty in the "micro 1 class note*" folder -- same design,
%%  different course line.  Keep the two in sync if you restyle one.)
%% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{metricsstyle}[2026/09/15 v1.0 House style for econometrics class notes]

\RequirePackage[T1]{fontenc}
\RequirePackage[margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{enumitem}
\RequirePackage{parskip}
\RequirePackage{needspace}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta}

% ------------------------------------------------------------------ look ----
\linespread{1.06}
\setlength{\parindent}{0pt}
\setcounter{secnumdepth}{2}

% -------------------------------------------------------------- notation ----
\newcommand{\R}{\mathbb{R}}                                     % real numbers
\newcommand{\E}{\mathbb{E}}                                     % expectation
\DeclareMathOperator{\Var}{Var}                                 % variance
\DeclareMathOperator{\Cov}{Cov}                                 % covariance
\DeclareMathOperator{\rank}{rank}                               % rank
\newcommand{\xT}{^{\prime}}                                     % transpose mark

% --------------------------------------------------------- title block ------
% \lessonheader{<lesson number>}{<subtitle>}{<date --- may be empty>}
\newcommand{\lessonheader}[3]{%
  \begin{center}
    {\large\scshape Econometrics I --- Class Notes}\\[3pt]
    {\LARGE\bfseries Lesson #1}\\[4pt]
    {\itshape #2}%
    \ifx\relax#3\relax\else\\[3pt]{\small #3}\fi
  \end{center}
  \vspace{0.4em}\hrule\vspace{0.9em}%
}

% ---------------------------------------------------- assignment title ------
% \hwheader{<assignment number>}{<term --- may be empty>}{<due date --- may be empty>}
% Same block as \lessonheader but for the problem sets, with the department
% letterhead the printed sheets carry.
\newcommand{\hwheader}[3]{%
  \begin{center}
    {\footnotesize\scshape Department of Economics and Finance\\
     Lang School of Business and Economics}\\[5pt]
    {\large\scshape ECON*6140 Econometrics I}\\[3pt]
    {\LARGE\bfseries Assignment \##1}\\[4pt]
    {\itshape #2}%
    \ifx\relax#3\relax\else\\[3pt]{\small #3}\fi
  \end{center}
  \vspace{0.4em}\hrule\vspace{0.9em}%
}

% Numbered item of a problem set: \question{(3)} then the text.
\newcommand{\question}[1]{\par\needspace{4\baselineskip}\medskip\noindent\textbf{#1}\par\nobreak\smallskip}

% ------------------------------------------------------------- headings -----
\newcommand{\topic}[1]{\par\Needspace{4\baselineskip}\medskip\noindent\textbf{#1}\par\nobreak\smallskip}
\newcommand{\runin}[1]{\par\medskip\noindent\textbf{#1}\quad\ignorespaces}

% --------------------------------------------------------------- lists ------
\newenvironment{flatlist}%
  {\begin{itemize}[leftmargin=1.3em,itemsep=2pt,topsep=3pt,parsep=0pt]}%
  {\end{itemize}}
\newenvironment{flatnum}%
  {\begin{enumerate}[leftmargin=1.5em,itemsep=2pt,topsep=3pt,parsep=0pt]}%
  {\end{enumerate}}

% -------------------------------------------------- transcription notes -----
\newenvironment{transcriptnotes}%
  {\par\vspace{1.4em}\Needspace{6\baselineskip}\hrule\vspace{0.5em}\small
   \noindent\textbf{Transcription notes}\par\vspace{0.2em}%
   \begin{itemize}[leftmargin=1.2em,itemsep=1.5pt,topsep=2pt,parsep=0pt]}%
  {\end{itemize}}

% ------------------------------------------------------------- diagrams -----
\tikzset{
  ecaxis/.style = {-{Stealth[length=4pt,width=3pt]},line width=0.5pt},
  budget/.style = {line width=0.9pt},
  adm/.style    = {line width=2.4pt},
  bundle/.style = {circle,fill=black,inner sep=1.4pt},
  ecnode/.style = {font=\small,inner sep=1.8pt}
}
% \ecaxes{<x-max>}{<y-max>}  --- two plain axes, origin bottom-left
\newcommand{\ecaxes}[2]{%
  \draw[ecaxis] (0,0) -- (#1,0);%
  \draw[ecaxis] (0,0) -- (0,#2);}

\endinput
